// Cloudflare Workers static-assets config for fostierindex.com.
// Deploy command in Cloudflare: npx wrangler deploy   (build command: node build.mjs)
{
  "name": "fostierindex",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    // Serve site/404.html with a real 404 status for unknown addresses.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
